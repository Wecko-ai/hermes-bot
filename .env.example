# HermesBot settings. All optional: the defaults suit a Hermes gateway on this machine.
# Each one can also go in config.json, in the app's data folder (macOS: ~/Library/Application Support/HermesBot/),
# under the name in brackets. See server/config.cjs.

# Hermes gateway address [gatewayOrigin]
HERMES_ORIGIN=http://127.0.0.1:9120

# Origin header sent to the gateway, if it only trusts its public address behind a reverse proxy [browserOrigin]
# HERMES_BROWSER_ORIGIN=https://hermes.example.com

# SSH host alias used to reach a gateway on another machine when none answers here [sshHost]
# HERMES_SSH_HOST=my-server

# Ollama, for the optional local chat [ollamaOrigin, localChat.model]
# OLLAMA_ORIGIN=http://127.0.0.1:11434
# HERMESBOT_LOCAL_MODEL=qwen3:8b

# Folder of optional bot animations: <profile>-working.webp and <profile>-done.webp [animationsDir]
# HERMESBOT_ANIMATIONS=/path/to/animations

# Another config file than the default one
# HERMESBOT_CONFIG=/path/to/config.json

# Interface preferences only exist in config.json, for example:
# {
#   "ui": {
#     "defaultBot": "my-bot",
#     "sectionOrder": ["Team A", "Team B"],
#     "userInitial": "A",
#     "hiddenProviders": [],
#     "contrastAvatars": []
#   }
# }
